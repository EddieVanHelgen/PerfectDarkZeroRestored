# Script mode (cmake -P), run at every build by the pdz_build_info target: writes OUT/pdz_build_info.h with the
# build time and the source commit (short hash, "+changes" when tracked files other than the
# user's settings/hardware.toml differ from it), for the startup line
# in the log (src/build_info.cpp). Written only when the commit text changes or the file is missing; the time is
# taken when it is written.
execute_process(COMMAND git -C "${SRC}" rev-parse --short HEAD
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SRC}" -c diff.ignoreSubmodules=all status --porcelain --untracked-files=no -- . ":!settings/hardware.toml"
                OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT commit)
    set(commit "unknown")
endif()
if(changes)
    set(commit "${commit}+changes")
endif()
string(TIMESTAMP now "%Y-%m-%d %H:%M:%S")
set(header "${OUT}/pdz_build_info.h")
set(old "")
if(EXISTS "${header}")
    file(STRINGS "${header}" old REGEX "PDZ_BUILD_COMMIT")
endif()
if(NOT old MATCHES "\"${commit}\"")
    file(WRITE "${header}" "// Generated by cmake/pdz_build_info.cmake at build time.\n#pragma once\n#define PDZ_BUILD_COMMIT \"${commit}\"\n#define PDZ_BUILD_TIME \"${now}\"\n")
endif()
