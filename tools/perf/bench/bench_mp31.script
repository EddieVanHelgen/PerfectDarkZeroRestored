# MP heavy fixed: dm on urban, 31 bots, points limit 15, time limit 10 min, human on free-for-all spawn pad 0, standing still (generated by tools/gen_mp_scripts.py heavy_fixed). Menus only: the values need --pdz_test_mp_setup=bots=31,points=15,time=10,map=urban,scenario=dm --pdz_test_spawn_pad=0 --pdz_test_god_mode=true --pdz_random_seed=20261027
press 8.0 A
press 10.0 A
press 12.0 A
press 14.0 A        # PRESS START title -> GAME MODE
press 17.0 DOWN     # -> COMBAT ARENA
press 19.0 A        # -> connection (LOCAL)
press 22.0 A        # LOCAL -> mode select (DEATHMATCH / DARK OPS)
press 25.0 A        # DEATHMATCH -> CREATE GAME | STANDARD
press 28.0 START    # CREATE -> GAME LOBBY (values from pdz_test_mp_setup, nothing edited)
press 32.0 START    # lobby: start the match
press 46.0 A        # match start: a spawn prompt, if any
press 50.0 A
repeat 76.0 400.0 30.0 A 0.15   # respawn fallback only (god mode: he should not die); no stick: the view stays at the spawn pad
