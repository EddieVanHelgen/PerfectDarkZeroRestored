# Boot -> mission 12 BRIDGE | ASSAULT for timing (PERF_FOR_EVERYONE.md; from BRIDGE_HITCH.md's fight script): 12 DOWN
# presses on MISSION SELECT, A through briefing / loading / cutscene to 115 s, then RT every 0.6 s while walking and
# turning. God mode on the command line.
press 8.0 A         # Microsoft logo / Rare intro just starting: normally ignored
press 10.0 A        # Rare intro video: skips it
press 12.0 A        # frontend loading: normally lost
press 14.0 A        # PRESS START title -> main menu
press 16.0 A        # main menu, Campaign -> MISSION MODE
press 18.0 A        # MISSION MODE, Solo Agent -> MISSION SELECT (MISSION 0 DATACORE, up by about 21 s)
press 24.0 DOWN     # MISSION SELECT -> 1 NIGHTCLUB | STAKEOUT
press 26.5 DOWN     # MISSION SELECT -> 2 SUBWAY | RETRIEVAL
press 29.0 DOWN     # MISSION SELECT -> 3 ROOFTOPS | ESCAPE
press 31.5 DOWN     # MISSION SELECT -> 4 MANSION | INFILTRATION
press 34.0 DOWN     # MISSION SELECT -> 5 LABORATORY | RESCUE
press 36.5 DOWN     # MISSION SELECT -> 6 RIVER | EXTRACTION
press 39.0 DOWN     # MISSION SELECT -> 7 TRINITY | INFILTRATION
press 41.5 DOWN     # MISSION SELECT -> 8 TRINITY | ESCAPE
press 44.0 DOWN     # MISSION SELECT -> 9 JUNGLE | STORM
press 46.5 DOWN     # MISSION SELECT -> 10 TEMPLE | SURVEILLANCE
press 49.0 DOWN     # MISSION SELECT -> 11 OUTPOST | RESCUE
press 51.5 DOWN     # MISSION SELECT -> 12 BRIDGE | ASSAULT
press 54.0 A        # MISSION SELECT: choose BRIDGE | ASSAULT
repeat 56.0 115.0 2.0 A 0.15   # setup / briefing / START MISSION / loading / cutscene skips
repeat 115.0 485.0 0.6 RT 0.35
stick 115.0 6.0 0 14000 0 0
stick 121.0 1.5 0 0 9000 0
stick 122.5 6.0 0 14000 0 0
