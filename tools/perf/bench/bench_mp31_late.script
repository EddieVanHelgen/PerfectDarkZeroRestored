# bench_mp31.script with every input 15 s later, for the slow CPU modes (PERF_FOR_EVERYONE.md: in deck mode the
# front end came up about 11 s after launch and the first presses were lost). Same setup arguments.
# MP heavy fixed: dm on urban, 31 bots, points limit 15, time limit 10 min, human on free-for-all spawn pad 0, standing still (generated by tools/gen_mp_scripts.py heavy_fixed). Menus only: the values need --pdz_test_mp_setup=bots=31,points=15,time=10,map=urban,scenario=dm --pdz_test_spawn_pad=0 --pdz_test_god_mode=true --pdz_random_seed=20261027
press 23.0 A
press 25.0 A
press 27.0 A
press 29.0 A        # PRESS START title -> GAME MODE
press 32.0 DOWN     # -> COMBAT ARENA
press 34.0 A        # -> connection (LOCAL)
press 37.0 A        # LOCAL -> mode select (DEATHMATCH / DARK OPS)
press 40.0 A        # DEATHMATCH -> CREATE GAME | STANDARD
press 43.0 START    # CREATE -> GAME LOBBY (values from pdz_test_mp_setup, nothing edited)
press 47.0 START    # lobby: start the match
press 61.0 A        # match start: a spawn prompt, if any
press 65.0 A
repeat 91.0 415.0 30.0 A   0.15 # respawn fallback only (god mode: he should not die); no stick: the view stays at the spawn pad
