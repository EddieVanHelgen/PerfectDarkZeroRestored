# Boot -> mission 1 NIGHTCLUB | STAKEOUT: 1 DOWN presses on MISSION SELECT, for run_all_missions.ps1.
# Generated by tools/gen_mission_scripts.py (routing from the 13:00 probe, log 108: linear list 0-13, nothing
# locked, a DOWN every 2.5 s from 24 s; the choose A 2.5 s after the last DOWN; then A every 2 s to 200 s).
press 8.0 A         # Microsoft logo / Rare intro just starting: normally ignored
press 10.0 A        # Rare intro video: skips it
press 12.0 A        # frontend loading: normally lost
press 14.0 A        # PRESS START title -> main menu
press 16.0 A        # main menu, Campaign -> MISSION MODE
press 18.0 A        # MISSION MODE, Solo Agent -> MISSION SELECT (MISSION 0 DATACORE, up by about 21 s)
press 24.0 DOWN     # MISSION SELECT -> 1 NIGHTCLUB | STAKEOUT
press 26.5 A        # MISSION SELECT: choose NIGHTCLUB | STAKEOUT
repeat 28.5 200.0 2.0 A 0.15   # setup / briefing / MISSION SUMMARY (START MISSION) / loading / cutscene skips, then in level
stick 95.0 8.0 0 0 14000 0
stick 105.0 8.0 0 0 14000 0
stick 115.0 8.0 0 0 14000 0
stick 125.0 8.0 0 0 -14000 0
stick 135.0 8.0 0 0 -14000 0
stick 145.0 8.0 0 0 14000 0
stick 155.0 8.0 0 0 14000 0
stick 165.0 8.0 0 0 14000 0
stick 175.0 8.0 0 0 -14000 0
stick 185.0 8.0 0 0 -14000 0
stick 195.0 8.0 0 0 14000 0
stick 205.0 8.0 0 0 14000 0
stick 215.0 8.0 0 0 -14000 0
stick 225.0 8.0 0 0 -14000 0
