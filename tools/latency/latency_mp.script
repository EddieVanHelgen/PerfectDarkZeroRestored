# pdz_latency_log test, multiplayer (tools/latency): boots to DEATHMATCH -> CREATE GAME and starts the match
# (scenario, map and bots from --pdz_test_mp_setup, as the bot sweep), then from 110 s alternately the right stick
# pushed right for 0.3 s and the trigger pulled for 0.12 s, 1.5 s apart (god mode keeps the human alive).
press 8.0 A
press 10.0 A
press 12.0 A
press 14.0 A        # PRESS START title -> GAME MODE
press 17.0 DOWN     # -> COMBAT ARENA
press 19.0 A        # -> connection (LOCAL)
press 22.0 A        # LOCAL -> mode select (DEATHMATCH / DARK OPS)
press 25.0 A        # DEATHMATCH -> CREATE GAME
press 29.0 START    # CREATE -> GAME LOBBY
press 33.0 START    # lobby: start the match
